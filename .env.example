# ==============================================================================
# CodeRush OJ 本地原生运行环境变量配置 (Native Execution Environment Variables)
# ==============================================================================

# ----------------- 数据库与中间件连接配置 (Database & Redis) -----------------
# 数据库连接 URL (请确保指向您本地运行的 MySQL，默认端口 3306)
DB_URL=jdbc:mysql://localhost:3306/coderush_oj?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false&createDatabaseIfNotExist=true
DB_USERNAME=coderushoj
DB_PASSWORD=coderushoj_pass

# Redis 缓存连接配置 (默认端口 6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------- 服务端口配置 (Service Ports) -----------------
# 后端 API 服务端口
SERVER_PORT=8080

# 前端开发服务端口 (Vite 默认 5173)
FRONTEND_PORT=5173

# ----------------- 评测沙箱配置 (Sandbox: go-judge) -----------------
# 沙箱服务监听端口 (本机运行 go-judge)
GO_JUDGE_PORT=5050
GO_JUDGE_BASE_URL=http://localhost:5050
GO_JUDGE_CONNECT_TIMEOUT_MS=5000
# 评测超时读取限制 (单位: 毫秒，必须大于 go-judge 编译最大时限)
GO_JUDGE_READ_TIMEOUT_MS=300000

# ----------------- 数据与存储配置 (Data & Logs) -----------------
# 本地测试数据和系统日志的存储根目录 (使用相对目录，防止权限问题或污染 C 盘)
APP_DATA_ROOT=./data/oj

# ----------------- 消息队列键名配置 (Queue Keys) -----------------
JUDGE_QUEUE_KEY=judge:queue
JUDGE_PROCESSING_KEY=judge:processing
JUDGE_DLQ_KEY=judge:dlq

# ----------------- 安全与全局配置 (Security & Global) -----------------
# Spring 运行 Profile (本地推荐 dev)
SPRING_PROFILES_ACTIVE=dev

# JWT 鉴权密钥 (开发可使用默认值，生产环境务必修改为 32 字符以上随机值)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_TTL_MINUTES=10080

# 初始管理员账号密码 (首次启动时自动导入数据库)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 跨域白名单 (CORS Allowed Origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONTEST_VISIBILITY_RELEASE_DELAY_MS=60000
