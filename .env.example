COMPOSE_PROJECT_NAME=localoj

MYSQL_ROOT_PASSWORD=localoj_root
MYSQL_DATABASE=local_oj
MYSQL_USER=localoj
MYSQL_PASSWORD=localoj_pass
MYSQL_PORT=127.0.0.1:3307
DB_USERNAME=localoj
DB_PASSWORD=localoj_pass

REDIS_PORT=127.0.0.1:6379
BACKEND_PORT=127.0.0.1:8080
FRONTEND_PORT=5173
GO_JUDGE_PORT=127.0.0.1:5050
GO_JUDGE_BASE_URL=http://go-judge:5050
APP_DATA_ROOT=/data
APP_WORKER_ID=judge-worker-1
JUDGE_QUEUE_KEY=judge:queue
JUDGE_PROCESSING_KEY=judge:processing
JUDGE_DLQ_KEY=judge:dlq

JWT_SECRET=change-this-internal-secret-at-least-32-bytes
JWT_TTL_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.*.*:5173,http://10.*.*.*:5173
CONTEST_VISIBILITY_RELEASE_DELAY_MS=60000
